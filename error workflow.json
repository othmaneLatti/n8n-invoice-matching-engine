        "subject": "⚠️ACTION REQUIRED : WORKFLOW FAILED !!",
        "message": "=<!DOCTYPE html> <html> <head>     <meta charset=\"UTF-8\">     <title>Workflow Error Alert</title> </head> <body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f4f7f6; color: #333333;\">     <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f4f7f6; padding: 40px 0;\">         <tr>             <td align=\"center\">                 <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); overflow: hidden; border-top: 6px solid #e53e3e;\">                     <!-- Header -->                     <tr>                         <td style=\"padding: 25px 30px; border-bottom: 1px solid #eeeeee; background-color: #fff5f5;\">                             <h2 style=\"color: #e53e3e; margin: 0; font-size: 20px;\">⚠️ Workflow Execution Failed</h2>                         </td>                     </tr>                     <!-- Body -->                     <tr>                         <td style=\"padding: 30px;\">                             <p style=\"margin-top: 0; font-size: 16px; line-height: 1.5;\">Hello,</p>                             <p style=\"font-size: 16px; line-height: 1.5;\">An automated workflow has encountered an error and stopped processing. Below is a plain-English summary of what went wrong.</p>                                                          <!-- AI Summary Box -->                             <div style=\"background-color: #f8f9fa; border-left: 4px solid #3182ce; padding: 15px; margin: 25px 0;\">                                 <p style=\"margin: 0; font-size: 15px; color: #2d3748; line-height: 1.6;\"><strong>AI Diagnosis:</strong><br>{{ $json.text }}</p>                             </div>                              <!-- Technical Details Table -->                             <table width=\"100%\" cellpadding=\"12\" cellspacing=\"0\" style=\"margin-bottom: 25px; border-collapse: collapse;\">                                 <tr style=\"border-bottom: 1px solid #eeeeee;\">                                     <td style=\"font-size: 14px; color: #718096; width: 35%;\"><strong>Workflow Name:</strong></td>                                     <td style=\"font-size: 14px; color: #2d3748; font-weight: 500;\">{{ $('Error Trigger').item.json.workflow.name }}</td>                                 </tr>                                 <tr style=\"border-bottom: 1px solid #eeeeee;\">                                     <td style=\"font-size: 14px; color: #718096;\"><strong>Failing Node:</strong></td>                                     <td style=\"font-size: 14px; color: #e53e3e; font-weight: 500;\">{{ $('Error Trigger').item.json.execution.lastNodeExecuted }}</td>                                 </tr>                                 <tr style=\"border-bottom: 1px solid #eeeeee;\">                                     <td style=\"font-size: 14px; color: #718096;\"><strong>Time of Error:</strong></td>                                     <td style=\"font-size: 14px; color: #2d3748; font-weight: 500;\">{{ $now.setZone('Africa/Algiers').toFormat('yyyy-MM-dd HH:mm:ss') }}</td>                                 </tr>                             </table>                                                          <!-- CTA Button -->                             <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top: 10px;\">                                 <tr>                                     <td align=\"center\">                                         <a href=\"{{ $('Error Trigger').item.json.execution.url }}\" style=\"display: inline-block; padding: 12px 24px; background-color: #2d3748; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: bold; border-radius: 4px;\">View Execution in n8n</a>                                     </td>                 